APP_NAME=Legoparts
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legoparts
DB_USERNAME=root
DB_PASSWORD=

# Must be >= 32 characters
ADMIN_API_KEY=

# Bootstrap admin created on first startup (min 12 chars password)
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173

PRODUCT_IMAGES_LOCAL_ROOT_PATH=uploads/products
PRODUCT_IMAGES_LOCAL_REQUEST_PATH=/media/products
PRODUCT_IMAGES_LOCAL_PUBLIC_BASE_URL=http://localhost:8000/media/products
PRODUCT_IMAGES_MAX_FILE_SIZE=5242880
