APP_NAME=Legoparts
APP_ENV=production
APP_KEY=
# Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://legoparts.by

LOG_CHANNEL=stack
LOG_LEVEL=warning

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=legoparts
DB_USERNAME=your_db_user
DB_PASSWORD=

# Must be >= 32 characters — generate with: php -r "echo base64_encode(random_bytes(48));"
ADMIN_API_KEY=

# Bootstrap admin created on first startup (min 12 chars password)
# Remove or clear these after the first login
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=

CORS_ALLOWED_ORIGINS=https://legoparts.by

PRODUCT_IMAGES_LOCAL_ROOT_PATH=uploads/products
PRODUCT_IMAGES_LOCAL_REQUEST_PATH=/media/products
PRODUCT_IMAGES_LOCAL_PUBLIC_BASE_URL=https://legoparts.by/media/products
PRODUCT_IMAGES_MAX_FILE_SIZE=5242880
